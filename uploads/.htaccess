# Só imagens públicas (animações de exercício e logos). Nada aqui pode ser executado.
Options -ExecCGI -Indexes
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh|html?|svg|js)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
  Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
